# ============================================================================
# .env.example — Plantilla de variables de entorno para Login-Automation
# ============================================================================
#
# INSTRUCCIONES:
#   1. Copiar este archivo a `.env` (NO se commitea, esta en .gitignore):
#        cp .env.example .env
#   2. Rellenar los valores reales en `.env`.
#   3. NO commitear `.env`. Verificar que esta en .gitignore.
#
# Mapeo rapido de variables (todas las que el codigo o las herramientas leen):
#   - src/logger_config.py        -> LOG_LEVEL
#   - src/browser_automation.py   -> TIMEOUT_SECONDS
#   - src/credentials.py          -> USERS_<USERID>_{LOCATION,USERNAME,PASSWORD}
#   - src/pancho_skills/enviar.py -> LOGIN_AUTOMATION_DB
#   - CLI opencode (opencode run) -> OPENCODE_GO_API_KEY, KIMI_API_KEY, GEMINI_API_KEY
#   - Telegram bot (Rubicita)     -> TELEGRAM_BOT_TOKEN_RUBICITA
#
# ============================================================================

# --- Logger ------------------------------------------------------------------
# Nivel de logging. Valores: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Browser (Selenium + ChromeDriver) ---------------------------------------
# Timeout por defecto en segundos para waits de Selenium.
TIMEOUT_SECONDS=15

# HEADLESS controla si Chrome se inicia con ventana visible o sin ella.
# Valores aceptados (case-insensitive): 1, true, yes, on. Cualquier otro (o vacio)
# se interpreta como False. Ausencia de la variable = False (visible).
# Uso:
#   - Desarrollo local: dejar vacio o HEADLESS=false (default) para ver Chrome.
#   - CI / produccion: HEADLESS=true para correr sin ventana.
# El caller puede sobreescribir pasando el kwarg explicito:
#   run_login(credentials, logger, headless=True)   # siempre headless
#   run_login(credentials, logger, headless=False)  # siempre visible
#   run_login(credentials, logger)                  # respeta HEADLESS env
HEADLESS=

# --- Credenciales de usuarios Rayen APS ---------------------------------------
# Formato: USERS_<USERID>_LOCATION / _USERNAME / _PASSWORD
# USERID en MAYUSCULAS (la lectura en credentials.py aplica .upper()).
#
# Ejemplo para Yadira (medica, CESFAM Raul Cuevas):
USERS_YADIRA_LOCATION=raulcuevas
USERS_YADIRA_USERNAME=261168111
USERS_YADIRA_PASSWORD=

# Plantilla para agregar otro usuario (copiar y rellenar):
USERS_<USERID>_LOCATION=
USERS_<USERID>_USERNAME=
USERS_<USERID>_PASSWORD=

# --- Cola SQLite (pancho_skills/enviar.py) -----------------------------------
# Path a la DB de la cola de fichas. Default si vacio:
#   <repo>/data/queue.db
#LOGIN_AUTOMATION_DB=

# --- LLM providers (CLI opencode) --------------------------------------------
# Provider default. La mayoria del flujo Mortadelo usa modelos `opencode-go/...`.
# El script `src/tools/generar_ficha_con_llm.py` invoca `opencode run --model ...`
# y opencode resuelve la key desde el environment.
#
# Respaldo: si opencode da problemas de cuota, se puede usar el provider directo
# con --model kimi/... o gemini-2.5-pro.
OPENCODE_GO_API_KEY=

# Kimi / Moonshot directo (kimi-k3, kimi-k2.7-code).
KIMI_API_KEY=

# Google Gemini directo (gemini-2.5-pro, gemini-3.1-pro-preview, gemini-2.5-flash).
# Usado como respaldo para vision/OCR.
GEMINI_API_KEY=

# --- Telegram (bot Rubicita) -------------------------------------------------
# Token del bot de Telegram que envia fichas a Yadira para aprobacion.
# Se obtiene con @BotFather. Sin este token, el flujo Telegram queda inactivo.
TELEGRAM_BOT_TOKEN_RUBICITA=