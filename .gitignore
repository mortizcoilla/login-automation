# Manuales MINSAL (190 MB, referenciados por path — no se commitean al repo)
data/manuales/

# Markdown convertido de manuales MINSAL (varios MB — fuente para el LLM).
# Se regenera con `python -m src.tools.convertir_manuales`. Vive en disco
# local, referenciado por path por los bundles.
data/manuales_md/

# Notas clinicas de pacientes (contienen RUN, nombre, direccion, telefono,
# datos clinicos). NO se commitean al repo publico. Vivir en disco local
# para revision Yadira; nunca al remoto.
# Sesion 2026-09-16: ahora son .md (markdown con frontmatter YAML).
# Sesion 2026-09-16 15:42: notas, manuales y plantillas viven bajo data/.
data/notas_clinicas/*.md
data/notas_clinicas/*.txt
data/notas_clinicas/*/*.md
data/notas_clinicas/*/_chrome_dl/

# Respaldo de anamnesis de Yadira (sesion 2026-09-16 15:14).
data/anamnesis/

# Info del paciente sin anamnesis (sesion 2026-09-16 17:45, pedido Yadira).
# Complementario a notas_clinicas/ — tiene todo MENOS la anamnesis cruda.
data/info_paciente/

# Inbox de fotos de examenes (Yadira via Pilita por Telegram). Local-only,
# reservado para uso futuro. Sesion 2026-09-16: carpeta movida desde
# data/notas_clinicas/_adjuntos/ a data/adjuntos/.
data/adjuntos/

# Examenes ya procesados por vision LLM. Local-only, reservado para
# uso futuro. Sesion 2026-09-16.
data/examenes/

# Fotos crudas de examenes recibidas por Telegram (Rubicita, paso 2).
# PII (imagenes de examenes con nombre/RUN del paciente). Ambos casings
# porque el script escribe Examenes_crudos y el FS de Windows es
# case-insensitive pero los patrones de git son case-sensitive.
data/examenes_crudos/
data/Examenes_crudos/

# Artefactos de datos derivados (PII de pacientes). Local-only.
data/cross_refs.json
data/ner.json
data/referencias.json

# Capturas de pantalla + HTML de diagnostico del flujo Selenium. Van a
# data/logs/screenshots/. Se borran con `python -m src.tools.limpiar_screenshots`
# al final de una corrida exitosa + tests OK.
data/logs/screenshots/
data/logs/

