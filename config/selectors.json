{
  "_comment": "Selectores DOM de Rayen APS. Si el sistema cambia su UI, actualice aqui sin tocar codigo.",
  "login": {
    "url": "https://clinico.rayenaps.cl/",
    "location": {"by": "id", "value": "location"},
    "username": {"by": "id", "value": "username"},
    "password": {"by": "id", "value": "password"},
    "submit": {"by": "css", "value": "button.orange-btn[type='submit']"},
    "submit_disabled": {"by": "css", "value": "button.orange-btn.disabled"},
    "modal": {"by": "css", "value": ".rescheck-modal"}
  },
  "menu": {
    "bars_icon": {"by": "css", "value": "span.pl-3.navbar-app-title"},
    "box_item": {"by": "css", "value": "li.navbar-dropdown.d-flex.justify-content-between"},
    "pacientes_citados": {"by": "css", "value": "span.text-wrap"}
  },
  "table": {
    "date_input": {"by": "css", "value": "input.date-input"},
    "estado_header": {"by": "xpath", "value": "//div[contains(@class, 'rt-th') and contains(., 'Estado')]"},
    "iniciado_cell": {"by": "xpath", "value": "//div[contains(@class, 'rt-td') and text()='Iniciado']"},
    "row_group": {"by": "xpath", "value": "./ancestor::div[contains(@class, 'rt-tr-group')]"},
    "cell": {"by": "css", "value": "div.rt-td"}
  },
  "alerts": {
    "close_selectors": [
      ".alert-info .close",
      ".alert-info button.close",
      ".alert-dismissible .close"
    ]
  },
  "timeouts": {
    "default": 15,
    "navigation": 20,
    "api_capture": 5
  }
}
